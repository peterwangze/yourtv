<?xml version="1.0" encoding="utf-8"?>
<!--
  播放层布局（FrameLayout）：
  - 备用播放器视图（standby_view）必须排在主视图（player_view）之前，
    确保 SurfaceFlinger 合成时主画面 z 序在上——即使备用 Surface 层因设备
    差异被合成显示，也永远不可能覆盖主画面（修复 CCTV2 盖 CCTV1 问题）。
  - 所有视图统一 FIT 等比缩放 + 居中，主/备视图共用同一套布局参数，
    比例表现完全一致。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- 备用播放器视图：后台预准备下一频道，切台时无缝接管
         （INVISIBLE 保持 surface 存活；z 序位于主视图之下） -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/standby_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        android:layout_gravity="center"
        android:background="#000000"
        android:keepScreenOn="true"
        app:shutter_background_color="#000000"
        app:resize_mode="fit"
        app:use_controller="false" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        android:layout_gravity="center"
        android:background="#000000"
        android:keepScreenOn="true"
        app:shutter_background_color="#000000"
        app:resize_mode="fit"
        app:use_controller="false" />

    <FrameLayout
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:backgroundTint="@android:color/black"
        android:keepScreenOn="true"
        android:visibility="gone" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/volume_up_24px"
        android:layout_gravity="center"
        android:layout_marginEnd="110dp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/volume"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="200dp"
        android:layout_height="5dp"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/custom_progress_drawable"
        android:layout_gravity="center"
        android:paddingStart="5dp"
        android:paddingEnd="0dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_source"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:text="@string/change_source"
        android:textSize="16sp"
        android:textColor="#66FFFFFF"
        android:background="@drawable/circle_background"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="0dp"
        android:visibility="gone" />

</FrameLayout>
