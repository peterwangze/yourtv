<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/program"
    android:layout_width="450dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F218242A"
    android:clickable="false"
    android:focusable="false">

    <TextView android:id="@+id/program_title"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:paddingStart="16dp" android:gravity="center_vertical"
        android:text="@string/program_guide" android:textColor="@color/focus" android:textSize="20sp" />
    <LinearLayout
        android:layout_width="450dp"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="#66000000">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tab_today"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/epg_today"
            android:textColor="@color/focus"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/focus_item_background"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tab_tomorrow"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/epg_tomorrow"
            android:textColor="@color/title_blur"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/focus_item_background"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="450dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="10dp"
        android:background="@android:color/transparent"
        android:visibility="gone" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/empty"
        android:layout_width="450dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:padding="24dp"
        android:gravity="center"
        android:text="@string/epg_is_empty"
        android:textColor="@color/description_blur"
        android:textSize="18sp"
        android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal">
        <Button android:id="@+id/refresh_epg"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:text="@string/epg_refresh_now" android:textColor="@color/white" android:textSize="16sp"
            android:background="@drawable/focus_item_background" android:focusable="true" />
        <Button android:id="@+id/configure_epg"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:text="@string/settings" android:textColor="@color/white" android:textSize="16sp"
            android:background="@drawable/focus_item_background" android:focusable="true" />
    </LinearLayout>
</LinearLayout>
