<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/program"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clickable="false"
    android:focusable="false">

    <!-- 分日切换（G8）：今天/明天，OK/点击切换 -->
    <LinearLayout
        android:layout_width="450dp"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="#66000000">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tab_today"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/epg_today"
            android:textColor="@color/focus"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/focus_item_background"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tab_tomorrow"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/epg_tomorrow"
            android:textColor="@color/title_blur"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/focus_item_background"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="450dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="10dp"
        android:background="@color/blur"
        android:visibility="gone" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/empty"
        android:layout_width="450dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/blur"
        android:gravity="center"
        android:text="@string/epg_is_empty"
        android:textColor="@color/description_blur"
        android:textSize="18sp"
        android:visibility="gone" />
</LinearLayout>
