<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setting"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4D000000"
    android:clickable="true"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:gravity="end"
    >
    <ScrollView
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:descendantFocusability="afterDescendants">
        <LinearLayout
            android:id="@+id/content"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="24dp"
            android:background="#4D000000"
            android:focusable="false"
            android:focusableInTouchMode="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/title_blur"
                    android:text="@string/app_name"
                    android:textStyle="bold"
                    android:background="@null"
                    android:textSize="18sp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_gravity="bottom" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/version_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/description_blur"
                    android:text=""
                    android:textSize="15sp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:textColor="@color/title_blur"
                android:textSize="15sp"
                android:background="@null"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:text="@string/project_address" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/group_playback_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="2dp"
                android:text="@string/group_playback"
                android:textColor="@color/focus"
                android:textSize="16sp"
                android:textStyle="bold"
                android:focusable="false" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchEnableWebviewType"
                android:text="@string/switch_to_web_video"
                android:textColor="@color/title_blur"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:background="@drawable/focus_item_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:thumbTint="@color/switch_thumb_color"
                app:trackTint="@color/switch_track_color" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_soft_decode"
                android:text="@string/soft_decode"
                android:textColor="@color/title_blur"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:background="@drawable/focus_item_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:thumbTint="@color/switch_thumb_color"
                app:trackTint="@color/switch_track_color"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_auto_switch_source"
                android:text="@string/auto_switch_source"
                android:textColor="@color/title_blur"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:background="@drawable/focus_item_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:thumbTint="@color/switch_thumb_color"
                app:trackTint="@color/switch_track_color" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_fast_zap"
                android:text="@string/fast_zap"
                android:textColor="@color/title_blur"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:background="@drawable/focus_item_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:thumbTint="@color/switch_thumb_color"
                app:trackTint="@color/switch_track_color" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_enable_screen_off_audio"
                android:text="@string/enable_screen_off_audio"
                android:textColor="@color/title_blur"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:background="@drawable/focus_item_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:thumbTint="@color/switch_thumb_color"
                app:trackTint="@color/switch_track_color" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_full_screen_mode"
                android:text="@string/full_screen_mode"
                android:textColor="@color/title_blur"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:background="@drawable/focus_item_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:thumbTint="@color/switch_thumb_color"
                app:trackTint="@color/switch_track_color" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/group_display_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="2dp"
                android:text="@string/group_display"
                android:textColor="@color/focus"
                android:textSize="16sp"
                android:textStyle="bold"
                android:focusable="false" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_channel_num"
                android:text="@string/title_channel_num"
                android:textColor="@color/title_blur"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:background="@drawable/focus_item_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:thumbTint="@color/switch_thumb_color"
                app:trackTint="@color/switch_track_color" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_time"
                android:text="@string/title_time"
                android:textColor="@color/title_blur"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:background="@drawable/focus_item_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:thumbTint="@color/switch_thumb_color"
                app:trackTint="@color/switch_track_color" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_display_seconds"
                android:text="@string/display_seconds"
                android:textColor="@color/title_blur"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:background="@drawable/focus_item_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:thumbTint="@color/switch_thumb_color"
                app:trackTint="@color/switch_track_color" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_compact_menu"
                android:text="@string/compact_menu"
                android:textColor="@color/title_blur"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:background="@drawable/focus_item_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:thumbTint="@color/switch_thumb_color"
                app:trackTint="@color/switch_track_color" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_show_source_button"
                android:text="@string/show_source_button"
                android:textColor="@color/title_blur"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:background="@drawable/focus_item_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:thumbTint="@color/switch_thumb_color"
                app:trackTint="@color/switch_track_color" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_channel_reversal"
                android:text="@string/title_channel_reversal"
                android:textColor="@color/title_blur"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:background="@drawable/focus_item_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:thumbTint="@color/switch_thumb_color"
                app:trackTint="@color/switch_track_color" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/group_favorite_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="2dp"
                android:text="@string/group_favorite"
                android:textColor="@color/focus"
                android:textSize="16sp"
                android:textStyle="bold"
                android:focusable="false" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_default_like"
                android:text="@string/title_default_like"
                android:textColor="@color/title_blur"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:background="@drawable/focus_item_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:thumbTint="@color/switch_thumb_color"
                app:trackTint="@color/switch_track_color" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_boot_startup"
                android:text="@string/title_boot_startup"
                android:textColor="@color/title_blur"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:background="@drawable/focus_item_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:thumbTint="@color/switch_thumb_color"
                app:trackTint="@color/switch_track_color" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_repeat_info"
                android:text="@string/title_repeat_info"
                android:textColor="@color/title_blur"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:background="@drawable/focus_item_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:thumbTint="@color/switch_thumb_color"
                app:trackTint="@color/switch_track_color" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_show_all_channels"
                android:text="@string/show_all_channels"
                android:textColor="@color/title_blur"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:background="@drawable/focus_item_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:thumbTint="@color/switch_thumb_color"
                app:trackTint="@color/switch_track_color" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/group_about_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="2dp"
                android:text="@string/group_about"
                android:textColor="@color/focus"
                android:textSize="16sp"
                android:textStyle="bold"
                android:focusable="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/remote_settings"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textColor="@color/title_blur"
                    android:layout_marginEnd="5dp"
                    android:textSize="16sp"
                    android:text="@string/server"
                    android:textStyle="bold"
                    android:stateListAnimator="@drawable/button_scale"
                    android:focusable="true"
                    android:focusedByDefault="true"
                    android:focusableInTouchMode="true" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/confirm_config"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textColor="@color/title_blur"
                    android:layout_marginEnd="5dp"
                    android:textSize="16sp"
                    android:text="@string/channels"
                    android:textStyle="bold"
                    android:stateListAnimator="@drawable/button_scale"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/clear"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textColor="@color/title_blur"
                    android:layout_marginEnd="5dp"
                    android:text="@string/clear"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@drawable/button_scale"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/check_version"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textColor="@color/title_blur"
                    android:layout_marginEnd="5dp"
                    android:textSize="16sp"
                    android:text="@string/check_version"
                    android:textStyle="bold"
                    android:stateListAnimator="@drawable/button_scale"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/verify_user"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textColor="@color/title_blur"
                    android:layout_marginEnd="5dp"
                    android:text="@string/verify_user"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@drawable/button_scale"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/appreciate"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textColor="@color/title_blur"
                    android:layout_marginEnd="5dp"
                    android:text="@string/appreciate"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@drawable/button_scale"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/update_epg"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textColor="@color/title_blur"
                    android:layout_marginEnd="5dp"
                    android:textSize="16sp"
                    android:text="@string/update_epg"
                    android:textStyle="bold"
                    android:stateListAnimator="@drawable/button_scale"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/refresh_source"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textColor="@color/title_blur"
                    android:layout_marginEnd="5dp"
                    android:textSize="16sp"
                    android:text="@string/refresh_source"
                    android:textStyle="bold"
                    android:stateListAnimator="@drawable/button_scale"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_exit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_marginTop="12dp"
                android:text="@string/exit_app"
                android:textColor="@color/title_blur"
                android:textSize="16sp"
                android:textStyle="bold"
                android:stateListAnimator="@drawable/button_scale"
                android:background="@drawable/focus_item_background"
                android:focusable="true"
                android:focusableInTouchMode="true" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
